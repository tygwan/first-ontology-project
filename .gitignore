# Project-specific: all data is excluded from git
# Rationale:
#   - data/raw/: authoritative source snapshot (95 MB), managed outside git
#   - data/powerbi/: derived star schema, regenerable by Phase 1
#   - data/working/: 1.7 GB of derived data from the (now-replaced) C# backend,
#     regenerable by Phase 1 Python code
#   - data/ontology/: generated by Phase 2
/data/

